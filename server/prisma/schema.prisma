// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  REQUESTED
  ACTIVE
  CANCEL_SCHEDULED
  CANCELLED
}

enum AuditEntityType {
  USER
  SUBSCRIPTION
}

model User {
  id              String  @id @default(uuid())
  email           String  @unique
  name            String
  passwordHash    String
  role            Role    @default(USER)
  isActive        Boolean @default(true)
  profileImageUrl String?

  subscriptions         Subscription[] @relation("OwnedSubscriptions")
  approvedSubscriptions Subscription[] @relation("ApprovedSubscriptions")
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
}

model Subscription {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation("OwnedSubscriptions", fields: [ownerId], references: [id])

  approvedById String?
  approvedBy   User?     @relation("ApprovedSubscriptions", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  toolName    String
  cost        Decimal            @db.Decimal(10, 2)
  renewalDate DateTime
  status      SubscriptionStatus @default(REQUESTED)
  cancelAt    DateTime? // populated when user schedules cancellation at renewalDate

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([renewalDate])
  @@index([cancelAt])
}

model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  entityType AuditEntityType
  entityId   String

  action String
  before Json?
  after  Json?

  createdAt DateTime @default(now())
}
